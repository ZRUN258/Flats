CompileFlags:
  # macOS clangd parses the PlatformIO database but is not an AVR compiler.
  # Keep all Arduino/PlatformIO flags, removing only target-only options that
  # Apple Clang cannot understand, then expose avr-libc's system headers.
  Remove:
    - -mmcu=*
    - -flto
  Add:
    - -D__AVR__
    - -D__AVR_ATmega2560__
    - -I/Users/zhangrun/.platformio/packages/toolchain-atmelavr/lib/gcc/avr/7.3.0/include
    - -I/Users/zhangrun/.platformio/packages/toolchain-atmelavr/lib/gcc/avr/7.3.0/include-fixed
    - -I/Users/zhangrun/.platformio/packages/toolchain-atmelavr/avr/include

Diagnostics:
  UnusedIncludes: Strict
